# ==========================================
# ORCA BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/orca

# Frontend
FRONTEND_URL=http://localhost:5173

# AI Service
AI_SERVICE_URL=http://localhost:8000

# GIS Service
GIS_SERVICE_URL=http://localhost:3005

# Ecosystem Service
ECOSYSTEM_SERVICE_URL=http://localhost:3006

# External Data Services
WEATHER_API_URL=
OCEAN_API_URL=

# Request configuration
REQUEST_TIMEOUT_MS=1000000000000
AI_ANALYZE_ENDPOINT=/api/v1/analyze

# Rate limiting
RATE_LIMIT_WINDOW_MS=9000000000000000
RATE_LIMIT_MAX_REQUESTS=10000000000000